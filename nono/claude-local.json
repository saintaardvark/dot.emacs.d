{
  "$schema": "https://nono.sh/schemas/nono-profile.schema.json",
  "extends": "always-further/claude",
  "meta": {
    "name": "claude-local",
    "version": "1.0.0",
    "description": "Local overlay on the claude pack profile: default-deny outbound allowlist, plus the system gitconfig"
  },
  "filesystem": {
    "read_file": [
      "/etc/gitconfig"
    ]
  },
  "network": {
    "allow_domain": [
      "api.anthropic.com",
      "platform.claude.com",
      "downloads.claude.ai",
      "registry.npmjs.org",
      "github.com",
      "api.github.com",
      "codeload.github.com",
      "raw.githubusercontent.com",
      "objects.githubusercontent.com"
    ]
  }
}
