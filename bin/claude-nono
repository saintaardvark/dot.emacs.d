#!/bin/sh
# claude-nono: launch Claude Code confined by the nono sandbox
# (https://nono.sh), for use as `claude-code-program' in Emacs.
#
# monet sets CLAUDE_CODE_SSE_PORT in the environment before Emacs
# launches claude; --open-port pokes a localhost-TCP hole in the
# sandbox on that port so claude can reach the MCP/IDE websocket
# server running inside Emacs.  Emacs itself stays outside the
# sandbox.
#
# The profile is claude-local, a local overlay on the signed
# always-further/claude pack: same filesystem policy, plus a
# default-deny outbound allowlist and read access to /etc/gitconfig.
# It is tracked at nono/claude-local.json; ~/.config/nono/profiles/ is
# not writable from inside the sandbox, so the live copy cannot be
# edited by the thing it confines.  Read it with:
#   nono profile show claude-local
#
# New machine: pull the pack, then promote the overlay -- see
# nono/README.md.  Both need a real terminal, not an Emacs session.
#
# NOTE: keep Claude Code's built-in sandbox disabled; nono is the
# single security boundary.  Otherwise claude retries blocked
# commands with dangerouslyDisableSandbox and you get two boundaries
# that are hard to audit.  See:
# https://nono.sh/docs/cli/clients/claude-code.md
#
# Outbound traffic is default-deny as of 2026-08-31: naming even one
# domain puts nono in proxy-only mode, and the list lives in the
# profile.  Consequences worth knowing before you debug something:
#
#   - WebFetch on an arbitrary host fails; it is fetched client-side.
#     WebSearch still works -- that one runs server-side.
#   - ssh git remotes do not survive proxy mode (HTTP CONNECT), and
#     every remote on this repo is ssh.  The agent can commit; you
#     push.
#   - pip / apt / go get reach nothing until their hosts are added.
#
# For a one-off host, without editing the profile:
#   M-x setenv RET CLAUDE_NONO_ALLOW_DOMAIN RET pypi.org files.pythonhosted.org
# Recurring needs belong in nono/claude-local.json, promoted by hand.
#
# See NETWORK-FILTERING-PLAN.md for the reasoning and the rollback.

set -eu

# Set CLAUDE_NONO_DEBUG=1 (e.g. via M-x setenv) to log what this
# wrapper sees at launch; compare with `env` inside the sandbox to
# tell whether nono is stripping the IDE handshake variables.
if [ -n "${CLAUDE_NONO_DEBUG:-}" ]; then
    {
        echo "=== claude-nono $(date)"
        echo "CLAUDE_CODE_SSE_PORT=${CLAUDE_CODE_SSE_PORT:-unset}"
        echo "ENABLE_IDE_INTEGRATION=${ENABLE_IDE_INTEGRATION:-unset}"
        echo "args: $*"
    } >> "${TMPDIR:-/tmp}/claude-nono.log"
fi

# Claude Code captures every Bash command's stdout under
# /tmp/claude-<uid>/; without this grant, shell commands inside the
# sandbox run but their output comes back blank.  mkdir first: the
# path must exist for the sandbox rule to attach.
harness_tmp="/tmp/claude-$(id -u)"
mkdir -p "$harness_tmp"

# Claude's external-editor key (C-x C-e in its TUI) shells out to
# $EDITOR; without this it lands in vi.  emacsclient reaches the Emacs
# server from inside the sandbox with no extra grant: nono mediates
# reads of the socket *directory* (ls /run/user/<uid>/emacs is denied,
# and `nono why` on the socket reports path_not_granted) but does not
# block connect() on the socket itself.  Tested 2026-08-04 --
# `emacsclient --eval '(+ 1 1)'` answers 2 from in here, and a full
# edit round trip works: emacsclient blocks, C-x # in Emacs releases
# it with exit 0, and the edited text is what claude reads back.
#
# Deliberately a bare word, no flags: claude may exec $EDITOR without
# a shell, in which case anything with a space would fail to resolve.
# The default socket is found via XDG_RUNTIME_DIR, which nono passes
# through, so no -s is needed.  If the Emacs server is ever down this
# errors out rather than falling back -- fine, since this wrapper is
# launched from Emacs.
EDITOR=emacsclient
VISUAL=emacsclient
export EDITOR VISUAL

if [ -n "${CLAUDE_CODE_SSE_PORT:-}" ]; then
    set -- --open-port "$CLAUDE_CODE_SSE_PORT" -- claude "$@"
else
    set -- -- claude "$@"
fi

# One-off widening for a single session; see the note above.  The
# variable is deliberately word-split, and deliberately not nono's own
# NONO_ALLOW_DOMAIN: that one is read by nono directly and it is not
# confirmed that a comma-separated value splits into several entries.
for domain in ${CLAUDE_NONO_ALLOW_DOMAIN:-}; do
    set -- --allow-domain "$domain" "$@"
done

# --allow "$harness_tmp" is redundant with the pack profile as of
# 0.0.16, which grants /tmp/claude-$UID itself.  Kept because it costs
# nothing and blank shell output is a miserable thing to re-diagnose.
exec nono run --profile claude-local --allow-cwd --allow "$harness_tmp" "$@"
